---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";

export async function getStaticPaths() {
  const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
  return lessons.map((lesson) => ({
    params: { lesson: String(lesson.data.order) },
    props: { lesson, lessons },
  }));
}

const { lesson, lessons } = Astro.props;
const { Content, headings } = await render(lesson);
---
<Base title={lesson.data.title}>
  <p><a href="../">← 2 小时上手 Godot</a></p>
  <div class="reading">
    <aside>
      <nav aria-label="系列章节">
        <strong>系列章节</strong>
        <ol>
          {lessons.map(({data}) => (
            <li><a href={`../${data.order}/`} aria-current={data.order === lesson.data.order ? "page" : undefined}>{data.title}</a></li>
          ))}
        </ol>
      </nav>
      {headings.some(({depth}) => depth === 2) && <details>
        <summary>本课目录</summary>
        <ul>{headings.filter(({depth}) => depth === 2).map(({slug, text}) => <li><a href={`#${slug}`}>{text}</a></li>)}</ul>
      </details>}
    </aside>
    <article>
      <h1>{lesson.data.title}</h1>
      <Content />
    </article>
  </div>
</Base>
